{
  "name": "zeerush-marble-race-show",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview --host 127.0.0.1 --port 4287 --strictPort",
    "soak": "tsx scripts/soak.ts",
    "soak:browser": "node scripts/browser.mjs",
    "soak:signatures": "tsx scripts/signature-soak.ts",
    "soak:signature-browser": "node scripts/signature-browser.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.30",
    "@types/three": "0.180.0",
    "eslint": "9.39.1",
    "playwright-core": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.2.2"
  }
}
